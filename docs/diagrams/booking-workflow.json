  "cards": [
    {
      "dot": "emerald",
      "title": "Happy path",
      "items": [
        "Tenant comes from the subdomain slug; the guest picks branch, professional, then services",
        "Free slots = location_hours - time_off - pending/confirmed appointments",
        "One transaction finds or creates the customer, inserts the appointment and frozen appointment_items"
      ]
    },
    {
      "dot": "rose",
      "title": "Guards",
      "items": [
        "EXCLUDE no_double_booking turns a race between two guests into a 409",
        "Deposit webhooks are deduplicated by (tenant_id, idempotency_key)",
        "A failed or unpaid deposit cancels the booking with cancelled_by = system"
      ]
    },
    {
      "dot": "slate",
      "title": "After booking",
      "items": [
        "Guest manages or cancels through booking_token, no account needed",
        "Staff mark completed or no_show; balance and refunds are new payment rows",
        "Only a completed appointment can receive its single review",
        "Status details: see appointment-lifecycle.html"
      ]
    }
  ]
}