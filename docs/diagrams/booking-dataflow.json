  "cards": [
    {
      "dot": "emerald",
      "title": "Guest path (designed flow)",
      "items": [
        "Order is location -> professional -> services -> time, then guest details",
        "Free slots = location_hours - time_off - pending/confirmed appointments",
        "Booking inserts appointment (pending) plus one appointment_item per service",
        "Guest reaches the booking later through booking_token, never an account",
        "Free slots also subtract pending/confirmed appointments for that staff member",
        "Free slots also subtract pending/confirmed appointments for that staff member"
      ]
    },
    {
      "dot": "rose",
      "title": "Integrity rules in the database",
      "items": [
        "Composite (tenant_id, id) FKs make cross-tenant bookings impossible",
        "appointment(staff_id, location_id) must exist in staff_location",
        "EXCLUDE no_double_booking blocks overlapping pending/confirmed slots (API: 409)",
        "review insert requires a completed appointment; hidden reviews do not count"
      ]
    },
    {
      "dot": "amber",
      "title": "Money",
      "items": [
        "appointment_item freezes service name, duration, price and deposit at booking time",
        "appointment_item freezes service name, duration, price and deposit at booking time",
        "Deposit = sum of service price x deposit_percent, frozen on each item",
        "payment rows are never updated into 'paid': refunds are new negative rows",
        "UNIQUE (tenant_id, idempotency_key) makes provider retries safe",
        "Provider webhooks set provider_payment_id and move status to succeeded or failed"
      ]
    },
    {
      "dot": "slate",
      "title": "Not on the guest path",
      "items": [
        "currency (USD, ARS) is a lookup referenced by location, appointment and payment",
        "currency (USD, ARS) is a lookup referenced by location, appointment and payment",
        "user_account: staff logins only, optional 1:0..1 link to staff",
        "Deferred tables: working_hours, location_closure",
        "No backend endpoints exist yet; flow is taken from schema comments",
        "review trigger keeps staff.rating_sum / rating_count in sync (published only)",
        "review trigger keeps staff.rating_sum / rating_count in sync (published only)"
      ]
    }
